{
	"name": "df_silver_incidente_ruta",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta",
						"type": "DatasetReference"
					},
					"name": "bronce"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "prepararLista"
				},
				{
					"name": "expandirRutas"
				},
				{
					"name": "limpiar"
				},
				{
					"name": "validos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronce",
				"bronce derive(ListaRutas = split(RutaHistoricaId, '\\\\|')) ~> prepararLista",
				"prepararLista foldDown(unroll(ListaRutas),",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal,",
				"          RutaExpandida = ListaRutas",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> expandirRutas",
				"expandirRutas derive(IncidenteId = upper(trim(IncidenteId)),",
				"          RutaHistoricaId = iif(\r",
				"    isNull(RutaExpandida) || trim(RutaExpandida) == '',\r",
				"    toString(null()),\r",
				"    iif(\r",
				"        regexMatch(upper(trim(RutaExpandida)), '^RH-'),\r",
				"        upper(trim(RutaExpandida)),\r",
				"        iif(\r",
				"            upper(trim(RutaExpandida)) == 'R12-N',\r",
				"            'RH-12-N',\r",
				"            iif(\r",
				"                upper(trim(RutaExpandida)) == 'R12-S',\r",
				"                'RH-12-S',\r",
				"                iif(\r",
				"                    lpad(replace(replace(replace(upper(trim(RutaExpandida)), 'RUTA ', ''), 'R-', ''), ' ', ''), 2, '0') == '07',\r",
				"                    'RH-07-OLD',\r",
				"                    iif(\r",
				"                        lpad(replace(replace(replace(upper(trim(RutaExpandida)), 'RUTA ', ''), 'R-', ''), ' ', ''), 2, '0') == '12',\r",
				"                        'RH-12-OLD',\r",
				"                        concat('RH-', lpad(replace(replace(replace(upper(trim(RutaExpandida)), 'RUTA ', ''), 'R-', ''), ' ', ''), 2, '0'))\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          EsPrincipal = iif(     isNull(EsPrincipal) || trim(EsPrincipal) == '',     iif(         trim(RutaExpandida) == trim(split(RutaHistoricaId, '\\\\|')[1]),         true(),         false()     ),     iif(         trim(EsPrincipal) == '1' || lower(trim(EsPrincipal)) == 'true',         true(),         false()     ) )) ~> limpiar",
				"limpiar filter(regexMatch(IncidenteId, '^IN-\\\\d{4}-\\\\d{4}$')",
				"&& !isNull(RutaHistoricaId)",
				"&& regexMatch(RutaHistoricaId, '^RH-')) ~> validos",
				"validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}