{
	"name": "df_silver_incidente_ruta",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta",
						"type": "DatasetReference"
					},
					"name": "bronce"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "limpiar"
				},
				{
					"name": "validos"
				},
				{
					"name": "deduplicar"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronce",
				"bronce derive(          IncidenteId = upper(trim(IncidenteId)),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          EsPrincipal = iif(trim(EsPrincipal) == '1' || lower(trim(EsPrincipal)) == 'true', true(), false())) ~> limpiar",
				"limpiar filter(regexMatch(IncidenteId, '^IN-\\\\d{4}-\\\\d{4}$') && regexMatch(RutaHistoricaId, '^RH-')) ~> validos",
				"validos aggregate(groupBy(IncidenteId, RutaHistoricaId),",
				"          EsPrincipal = first(EsPrincipal)) ~> deduplicar",
				"deduplicar sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId = string,",
				"          RutaHistoricaId = string,",
				"          EsPrincipal = boolean",
				"     )) ~> sink1"
			]
		}
	}
}