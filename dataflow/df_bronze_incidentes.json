{
	"name": "df_bronze_incidentes",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2022_xsl",
						"type": "DatasetReference"
					},
					"name": "xls22"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2023_xsl",
						"type": "DatasetReference"
					},
					"name": "xls23"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "dercsv"
				},
				{
					"name": "norcsv"
				},
				{
					"name": "dernorxls22"
				},
				{
					"name": "norxls22"
				},
				{
					"name": "dernorxls23"
				},
				{
					"name": "norxls23"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls22",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls23",
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv derive(          AnioFuente = regexExtract(trim(id_incidente), 'IN-(\\\\d{4})', 1),",
				"          IncidenteId = upper(trim(id_incidente)),",
				"          TipoIncidente = upper(trim(tipo)),",
				"          Severidad = upper(trim(severidad)),",
				"          FechaHoraInicio = iif(isNull(fecha_inicio) || isNull(hora_inicio), toString(null()), iif(instr(trim(fecha_inicio), '/') > 0, toString(toTimestamp(concat(trim(fecha_inicio), ' ', trim(hora_inicio), ':00'), 'dd/MM/yyyy HH:mm:ss'), 'yyyy-MM-dd HH:mm:ss'), toString(toTimestamp(concat(left(trim(fecha_inicio), 10), ' ', trim(hora_inicio), ':00'), 'yyyy-MM-dd HH:mm:ss'), 'yyyy-MM-dd HH:mm:ss'))),",
				"          FechaHoraFin = iif(isNull(fecha_fin) || isNull(hora_fin), toString(null()), iif(instr(trim(fecha_fin), '/') > 0, toString(toTimestamp(concat(trim(fecha_fin), ' ', trim(hora_fin), ':00'), 'dd/MM/yyyy HH:mm:ss'), 'yyyy-MM-dd HH:mm:ss'), toString(toTimestamp(concat(left(trim(fecha_fin), 10), ' ', trim(hora_fin), ':00'), 'yyyy-MM-dd HH:mm:ss'), 'yyyy-MM-dd HH:mm:ss'))),",
				"          FechaHoraRegistro = iif(isNull(fecha_registro), toString(null()), iif(instr(trim(fecha_registro), '/') > 0, toString(toTimestamp(concat(trim(fecha_registro), ' 00:00:00'), 'dd/MM/yyyy HH:mm:ss'), 'yyyy-MM-dd HH:mm:ss'), concat(left(trim(fecha_registro), 10), ' 00:00:00'))),",
				"          VehiculoId = iif(isNull(vehiculo_afectado) || trim(vehiculo_afectado) == '', toString(null()), concat('V-', lpad(replace(upper(trim(vehiculo_afectado)), 'V-', ''), 3, '0'))),",
				"          Descripcion = trim(descripcion)) ~> dercsv",
				"dercsv select(mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norcsv",
				"xls22 derive(          AnioFuente = '2022',",
				"          IncidenteId = upper(trim(id_incidente)),",
				"          TipoIncidente = upper(trim(tipo)),",
				"          Severidad = upper(trim(severidad)),",
				"          FechaHoraInicio = iif(isNull(fecha_inicio) || isNull(hora_inicio), toString(null()), concat(iif(regexMatch(trim(fecha_inicio), '^\\\\d{5}(\\\\.\\\\d+)?$'), toString(addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(fecha_inicio), '(\\\\d+)', 1))), 'yyyy-MM-dd'), left(trim(fecha_inicio), 10)), ' ', iif(regexExtract(toString(hora_inicio), '(\\\\d{2}:\\\\d{2})', 1) == '', '00:00:00', concat(regexExtract(toString(hora_inicio), '(\\\\d{2}:\\\\d{2})', 1), ':00')))),",
				"          FechaHoraFin = iif(isNull(fecha_fin) || isNull(hora_fin), toString(null()), concat(iif(regexMatch(trim(fecha_fin), '^\\\\d{5}(\\\\.\\\\d+)?$'), toString(addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(fecha_fin), '(\\\\d+)', 1))), 'yyyy-MM-dd'), left(trim(fecha_fin), 10)), ' ', iif(regexExtract(toString(hora_fin), '(\\\\d{2}:\\\\d{2})', 1) == '', '00:00:00', concat(regexExtract(toString(hora_fin), '(\\\\d{2}:\\\\d{2})', 1), ':00')))),",
				"          FechaHoraRegistro = iif(isNull(fecha_registro), toString(null()), concat(iif(regexMatch(trim(fecha_registro), '^\\\\d{5}(\\\\.\\\\d+)?$'), toString(addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(fecha_registro), '(\\\\d+)', 1))), 'yyyy-MM-dd'), left(trim(fecha_registro), 10)), ' 00:00:00')),",
				"          VehiculoId = iif(isNull(vehiculo_afectado) || trim(vehiculo_afectado) == '', toString(null()), concat('V-', lpad(replace(upper(trim(vehiculo_afectado)), 'V-', ''), 3, '0'))),",
				"          Descripcion = trim(descripcion)) ~> dernorxls22",
				"dernorxls22 select(mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norxls22",
				"xls23 derive(          AnioFuente = '2023',",
				"          IncidenteId = upper(trim(id_incidente)),",
				"          TipoIncidente = upper(trim(tipo)),",
				"          Severidad = upper(trim(severidad)),",
				"          FechaHoraInicio = iif(isNull(fecha_inicio) || isNull(hora_inicio), toString(null()), concat(iif(regexMatch(trim(fecha_inicio), '^\\\\d{5}(\\\\.\\\\d+)?$'), toString(addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(fecha_inicio), '(\\\\d+)', 1))), 'yyyy-MM-dd'), left(trim(fecha_inicio), 10)), ' ', iif(regexExtract(toString(hora_inicio), '(\\\\d{2}:\\\\d{2})', 1) == '', '00:00:00', concat(regexExtract(toString(hora_inicio), '(\\\\d{2}:\\\\d{2})', 1), ':00')))),",
				"          FechaHoraFin = iif(isNull(fecha_fin) || isNull(hora_fin), toString(null()), concat(iif(regexMatch(trim(fecha_fin), '^\\\\d{5}(\\\\.\\\\d+)?$'), toString(addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(fecha_fin), '(\\\\d+)', 1))), 'yyyy-MM-dd'), left(trim(fecha_fin), 10)), ' ', iif(regexExtract(toString(hora_fin), '(\\\\d{2}:\\\\d{2})', 1) == '', '00:00:00', concat(regexExtract(toString(hora_fin), '(\\\\d{2}:\\\\d{2})', 1), ':00')))),",
				"          FechaHoraRegistro = iif(isNull(fecha_registro), toString(null()), concat(iif(regexMatch(trim(fecha_registro), '^\\\\d{5}(\\\\.\\\\d+)?$'), toString(addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(fecha_registro), '(\\\\d+)', 1))), 'yyyy-MM-dd'), left(trim(fecha_registro), 10)), ' 00:00:00')),",
				"          VehiculoId = iif(isNull(vehiculo_afectado) || trim(vehiculo_afectado) == '', toString(null()), concat('V-', lpad(replace(upper(trim(vehiculo_afectado)), 'V-', ''), 3, '0'))),",
				"          Descripcion = trim(descripcion)) ~> dernorxls23",
				"dernorxls23 select(mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norxls23",
				"norcsv, norxls22, norxls23, sql union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}