{
	"name": "df_bronze_incidentes",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2022_xsl",
						"type": "DatasetReference"
					},
					"name": "xls22"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2023_xsl",
						"type": "DatasetReference"
					},
					"name": "xls23"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "dernorcsv"
				},
				{
					"name": "norcsv"
				},
				{
					"name": "dernorxls22"
				},
				{
					"name": "norxls22"
				},
				{
					"name": "dernorxls23"
				},
				{
					"name": "norxls23"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls22",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls23",
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv derive(          AnioFuente = regexExtract(trim(id_incidente), 'IN-(\\\\d{4})', 1),",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraInicio = concat(coalesce(fecha_inicio, ''), ' ', coalesce(hora_inicio, '')),",
				"          FechaHoraFin = concat(coalesce(fecha_fin, ''), ' ', coalesce(hora_fin, '')),",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion) ~> dernorcsv",
				"dernorcsv select(mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norcsv",
				"xls22 derive(          AnioFuente = '2022',",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraInicio = concat(coalesce(fecha_inicio, ''), ' ', coalesce(hora_inicio, '')),",
				"          FechaHoraFin = concat(coalesce(fecha_fin, ''), ' ', coalesce(hora_fin, '')),",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion) ~> dernorxls22",
				"dernorxls22 select(mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norxls22",
				"xls23 derive(          AnioFuente = '2023',",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraInicio = concat(coalesce(fecha_inicio, ''), ' ', coalesce(hora_inicio, '')),",
				"          FechaHoraFin = concat(coalesce(fecha_fin, ''), ' ', coalesce(hora_fin, '')),",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion) ~> dernorxls23",
				"dernorxls23 select(mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norxls23",
				"norcsv, norxls22, norxls23, sql union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}