{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas",
						"type": "DatasetReference"
					},
					"name": "bronce"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "limpiar"
				},
				{
					"name": "filtrarNulos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronce",
				"bronce derive(FechaServicio = iif(\r",
				"    isNull(FechaServicio) || trim(FechaServicio) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(trim(FechaServicio), '^\\\\d{5}(\\\\.\\\\d+)?$'),\r",
				"        addDays(toDate('1899-12-30'), toInteger(regexExtract(trim(FechaServicio), '(\\\\d+)', 1))),\r",
				"        iif(\r",
				"            instr(trim(FechaServicio), '/') > 0,\r",
				"            toDate(left(trim(FechaServicio), 10), 'dd/MM/yyyy'),\r",
				"            toDate(left(trim(FechaServicio), 10), 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				")\r",
				",",
				"          RutaHistoricaId = iif(\r",
				"    isNull(RutaHistoricaId) || trim(RutaHistoricaId) == '',\r",
				"    toString(null()),\r",
				"    iif(\r",
				"        regexMatch(upper(trim(RutaHistoricaId)), '^RH-'),\r",
				"        upper(trim(RutaHistoricaId)),\r",
				"        iif(\r",
				"            upper(trim(RutaHistoricaId)) == 'R12-N',\r",
				"            'RH-12-N',\r",
				"            iif(\r",
				"                upper(trim(RutaHistoricaId)) == 'R12-S',\r",
				"                'RH-12-S',\r",
				"                iif(\r",
				"                    lpad(replace(replace(replace(upper(trim(RutaHistoricaId)), 'RUTA ', ''), 'R-', ''), ' ', ''), 2, '0') == '07',\r",
				"                    'RH-07-OLD',\r",
				"                    iif(\r",
				"                        lpad(replace(replace(replace(upper(trim(RutaHistoricaId)), 'RUTA ', ''), 'R-', ''), ' ', ''), 2, '0') == '12',\r",
				"                        'RH-12-OLD',\r",
				"                        concat('RH-', lpad(replace(replace(replace(upper(trim(RutaHistoricaId)), 'RUTA ', ''), 'R-', ''), ' ', ''), 2, '0'))\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = replace(trim(Franja), ' ', ''),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          Descensos = toInteger(trim(Descensos)),",
				"          DemandaNoAtendida = toInteger(trim(DemandaNoAtendida)),",
				"          Metodo = upper(trim(Metodo))) ~> limpiar",
				"limpiar filter(regexMatch(DemandaId, '^DM-\\\\d{4}-\\\\d{5}$')",
				"&& !isNull(FechaServicio)",
				"&& !isNull(RutaHistoricaId)",
				"&& regexMatch(RutaHistoricaId, '^RH-')",
				"&& !isNull(ParadaHistoricaId)",
				"&& ParadaHistoricaId != ''",
				"&& regexMatch(Franja, '^\\\\d{2}:\\\\d{2}-\\\\d{2}:\\\\d{2}$')",
				"&& !isNull(ValidacionesTarjeta)",
				"&& !isNull(Descensos)",
				"&& !isNull(DemandaNoAtendida)",
				"&& Metodo != '') ~> filtrarNulos",
				"filtrarNulos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}