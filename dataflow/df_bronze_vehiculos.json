{
	"name": "df_bronze_vehiculos",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_vehiculos_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_vehiculos_2022_xsl",
						"type": "DatasetReference"
					},
					"name": "xls22"
				},
				{
					"dataset": {
						"referenceName": "bronze_vehiculos_2023_xsl",
						"type": "DatasetReference"
					},
					"name": "xls23"
				},
				{
					"dataset": {
						"referenceName": "bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "dernorcsv"
				},
				{
					"name": "norcsv"
				},
				{
					"name": "dernorxls22"
				},
				{
					"name": "norxls22"
				},
				{
					"name": "dernorxls23"
				},
				{
					"name": "norxls23"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls22",
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls23",
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv derive(          AnioFuente = '2020',",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado) ~> dernorcsv",
				"dernorcsv select(mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norcsv",
				"xls22 derive(          AnioFuente = '2022',",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado) ~> dernorxls22",
				"dernorxls22 select(mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norxls22",
				"xls23 derive(          AnioFuente = '2023',",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado) ~> dernorxls23",
				"dernorxls23 select(mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> norxls23",
				"norcsv, norxls22, norxls23, sql union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}