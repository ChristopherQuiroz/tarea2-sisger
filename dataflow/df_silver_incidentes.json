{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes",
						"type": "DatasetReference"
					},
					"name": "bronce"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "limpiar"
				},
				{
					"name": "validos"
				},
				{
					"name": "deduplicar"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronce",
				"bronce derive(          IncidenteId = upper(trim(IncidenteId)),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          FechaHoraInicio = iif(isNull(FechaHoraInicio) || trim(FechaHoraInicio) == '', toTimestamp(null()), iif(instr(trim(FechaHoraInicio), '/') > 0, toTimestamp(trim(FechaHoraInicio), 'dd/MM/yyyy HH:mm:ss'), toTimestamp(replace(left(trim(FechaHoraInicio), 19), 'T', ' '), 'yyyy-MM-dd HH:mm:ss'))),",
				"          FechaHoraFin = iif(isNull(FechaHoraFin) || trim(FechaHoraFin) == '', toTimestamp(null()), iif(instr(trim(FechaHoraFin), '/') > 0, toTimestamp(trim(FechaHoraFin), 'dd/MM/yyyy HH:mm:ss'), toTimestamp(replace(left(trim(FechaHoraFin), 19), 'T', ' '), 'yyyy-MM-dd HH:mm:ss'))),",
				"          FechaHoraRegistro = iif(isNull(FechaHoraRegistro) || trim(FechaHoraRegistro) == '', toTimestamp(null()), iif(instr(trim(FechaHoraRegistro), '/') > 0, toTimestamp(trim(FechaHoraRegistro), 'dd/MM/yyyy HH:mm:ss'), toTimestamp(replace(left(trim(FechaHoraRegistro), 19), 'T', ' '), 'yyyy-MM-dd HH:mm:ss'))),",
				"          VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '', toString(null()), upper(trim(VehiculoId))),",
				"          Descripcion = trim(Descripcion)) ~> limpiar",
				"limpiar filter(regexMatch(IncidenteId, '^IN-\\\\d{4}-\\\\d{4}$') && TipoIncidente != '' && Severidad != '' && not(isNull(FechaHoraInicio)) && not(isNull(FechaHoraFin)) && not(isNull(FechaHoraRegistro)) && Descripcion != '') ~> validos",
				"validos aggregate(groupBy(IncidenteId),",
				"          TipoIncidente = first(TipoIncidente),",
				"          Severidad = first(Severidad),",
				"          FechaHoraInicio = first(FechaHoraInicio),",
				"          FechaHoraFin = first(FechaHoraFin),",
				"          FechaHoraRegistro = first(FechaHoraRegistro),",
				"          VehiculoId = first(VehiculoId),",
				"          Descripcion = first(Descripcion)) ~> deduplicar",
				"deduplicar sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId = string,",
				"          TipoIncidente = string,",
				"          Severidad = string,",
				"          FechaHoraInicio = timestamp,",
				"          FechaHoraFin = timestamp,",
				"          FechaHoraRegistro = timestamp,",
				"          VehiculoId = string,",
				"          Descripcion = string",
				"     )) ~> sink1"
			]
		}
	}
}