{
	"name": "pipeline_silver",
	"properties": {
		"activities": [
			{
				"name": "AuditarBronzeYLimpiarSilver",
				"description": "Audita bronze y vacia silver.* respetando las FK antes de recargar.",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "sql_dw_transporte",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "-- Auditoria de calidad de bronze (visible en la salida de la actividad).\n-- Los residuos que aqui aparezcan son filas que silver filtrara por diseño.\nSELECT 'Rutas' AS Tabla, COUNT(*) AS Filas,\n       SUM(CASE WHEN NULLIF(LTRIM(RTRIM(RutaHistoricaId)), '') IS NULL THEN 1 ELSE 0 END) AS SinId\nFROM bronze.Rutas\nUNION ALL\nSELECT 'Paradas', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(ParadaHistoricaId)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.Paradas\nUNION ALL\nSELECT 'Vehiculos', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(VehiculoId)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.Vehiculos\nUNION ALL\nSELECT 'Viajes', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(ViajeId)), '') IS NULL\n                                  OR NULLIF(LTRIM(RTRIM(RutaHistoricaId)), '') IS NULL\n                                  OR NULLIF(LTRIM(RTRIM(VehiculoId)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.Viajes\nUNION ALL\nSELECT 'DemandaParadas', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(DemandaId)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.DemandaParadas\nUNION ALL\nSELECT 'Incidentes', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(IncidenteId)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.Incidentes\nUNION ALL\nSELECT 'IncidenteRuta', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(IncidenteId)), '') IS NULL\n                                        OR NULLIF(LTRIM(RTRIM(RutaHistoricaId)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.IncidenteRuta;"
						},
						{
							"type": "Query",
							"text": "-- Limpieza de silver en orden de dependencias (hijos primero) para recarga idempotente.\nDELETE FROM silver.IncidenteRuta;\nDELETE FROM silver.DemandaParadas;\nDELETE FROM silver.Viajes;\nDELETE FROM silver.Incidentes;\nDELETE FROM silver.Vehiculos;\nDELETE FROM silver.Paradas;\nDELETE FROM silver.Rutas;"
						}
					]
				}
			},
