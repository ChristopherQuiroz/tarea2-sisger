{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ucb-transporte-us-8846535"
		},
		"sa_transporte_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'sa_transporte'"
		},
		"sql_dw_transporte_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_dw_transporte'"
		},
		"sql_rpe_transporte_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_rpe_transporte'"
		},
		"sa_transporte_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbtransporte8846535.dfs.core.windows.net/"
		},
		"sql_dw_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-8846535.database.windows.net"
		},
		"sql_dw_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"sql_dw_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": " chrisquiroz"
		},
		"sql_rpe_transporte_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-8846535.database.windows.net"
		},
		"sql_rpe_transporte_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"sql_rpe_transporte_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chrisquiroz"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ucb-transporte-us-8846535_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"sa_transporte_accountKey": {
						"value": "[parameters('sa_transporte_accountKey')]"
					},
					"sql_dw_transporte_password": {
						"value": "[parameters('sql_dw_transporte_password')]"
					},
					"sql_rpe_transporte_password": {
						"value": "[parameters('sql_rpe_transporte_password')]"
					},
					"sa_transporte_properties_typeProperties_url": {
						"value": "[parameters('sa_transporte_properties_typeProperties_url')]"
					},
					"sql_dw_transporte_properties_typeProperties_server": {
						"value": "[parameters('sql_dw_transporte_properties_typeProperties_server')]"
					},
					"sql_dw_transporte_properties_typeProperties_database": {
						"value": "[parameters('sql_dw_transporte_properties_typeProperties_database')]"
					},
					"sql_dw_transporte_properties_typeProperties_userName": {
						"value": "[parameters('sql_dw_transporte_properties_typeProperties_userName')]"
					},
					"sql_rpe_transporte_properties_typeProperties_server": {
						"value": "[parameters('sql_rpe_transporte_properties_typeProperties_server')]"
					},
					"sql_rpe_transporte_properties_typeProperties_database": {
						"value": "[parameters('sql_rpe_transporte_properties_typeProperties_database')]"
					},
					"sql_rpe_transporte_properties_typeProperties_userName": {
						"value": "[parameters('sql_rpe_transporte_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-ucb-transporte-us-8846535_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-ucb-transporte-us-8846535_ArmTemplate_0')]"
			]
		}
	]
}